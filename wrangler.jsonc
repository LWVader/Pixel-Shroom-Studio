{
  "name": "pixel-shroom-studio",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-04",
  "minify": true,
  "build": { "command": "npm run build", "watch_dir": ["public", "tools"] },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page",
  },
}
