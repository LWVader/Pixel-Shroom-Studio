# Copy to gelato.env.local (gitignored), fill locally, and upload to Supabase secrets.
# Never put these values in public/config.js or commit real credentials.
GELATO_API_KEY=
GELATO_MODE=sandbox
GELATO_CHECKOUT_ENABLED=false
GELATO_LIVE_ENABLED=false
GELATO_STRIPE_SECRET_KEY=
GELATO_STRIPE_WEBHOOK_SECRET=
GELATO_STRIPE_TAX_READY=false
