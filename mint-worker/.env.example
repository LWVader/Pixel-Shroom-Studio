# Private rendering server only. Never use public/config.js for these values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
MINT_SIGNING_KEY_FILE=/absolute/private/path/mint-private.pem
# Existing Stripe key, used only for provider-confirmed checkout reconciliation.
STRIPE_SECRET_KEY=YOUR_PRIVATE_STRIPE_SECRET
